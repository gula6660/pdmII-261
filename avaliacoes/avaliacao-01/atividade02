class StackCollection <T> {
      final List <T> data = [];
      
      push(T value) => data.add(value);
      T pop() => data.removeLast();
  }

void main() {

final pilha = StackCollection <String>();

pilha.push("Calca");
pilha.push("Blusa");
pilha.push("Top");

final Camisa = pilha.pop;

 print(pilha);
}
